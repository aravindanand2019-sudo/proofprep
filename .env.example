# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add the same keys under Project Settings > Environment Variables.

# --- Firebase client SDK (public; Firebase console > Project settings > Your apps > Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only; Project settings > Service accounts > Generate new private key) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value in double quotes, keeping the literal \n sequences.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- LLM (server only) ---
# Provider behind lib/llm/call.ts: "claude" or "gemini".
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional overrides; defaults are in lib/llm/models.ts (PLAN.md Section 6).
LLM_MODEL_STRONG=
LLM_MODEL_FAST=

# --- Used by later tracks (not read by the foundation yet) ---
# Track C: GitHub REST API token (fine-grained, public repo read-only).
GITHUB_TOKEN=
# Track D: Deepgram speech-to-text.
DEEPGRAM_API_KEY=
